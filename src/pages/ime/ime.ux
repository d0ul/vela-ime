<template>
  <div class="page">
    <!-- The title follows the curved top of the screen (see utils/arc.js) so the bezel cannot cut it. -->
    <div class="arc">
      <text class="{{ 'ac ' + a.cls }}" for="{{ a in arc }}" style="left: {{ a.left }}px; top: {{ a.top }}px; font-size: {{ a.fs }}px;">{{ a.c }}</text>
    </div>

    <!-- Tapping the text area inserts a space, which also ends the character being typed. -->
    <div class="txt" onclick="space">
      <text class="{{ text ? 'tv' : 'tv ph' }}">{{ shown }}<span class="{{ caretOn ? 'caret' : 'caret off' }}">|</span></text>
    </div>

    <scroll class="strip" scroll-x="true">
      <div class="srow">
        <div class="sc" for="{{ s in strip }}" onclick="choose(s.w)">
          <text class="{{ s.hi ? 'sw hi' : 'sw' }}">{{ s.w }}</text>
        </div>
      </div>
    </scroll>

    <div class="pad">
      <div class="{{ 'key ' + b.cls }}" for="{{ b in keys }}" onclick="tap(b.k)">
        <image class="ki" if="{{ b.ic }}" src="{{ b.ic }}"></image>
        <text class="{{ b.tcls }}" if="{{ !b.ic }}">{{ b.l }}</text>
      </div>
    </div>

    <div class="ok" onclick="ok">
      <image class="oi" src="/common/ime/check-48.indexed_8.png"></image>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import { suggest } from '../../utils/suggest.js'
import { press, atoms, display, backspace } from '../../utils/cheonjiin.js'
import { finishIme } from '../../utils/ime.js'
import { arcText } from '../../utils/arc.js'

let seq = 0 // a slow suggestion lookup must not overwrite a newer one
const MAX_SUGGEST = 3 // a short strip: fewer chips to build and to hold in memory on a small device
let blink = 0 // the cursor's timer id

const DEL = '/common/ime/delete-40.indexed_8.png'
const GLOBE = '/common/ime/globe-40.indexed_8.png'
const SPACE = '/common/ime/space-40.indexed_8.png'

// [key, label, key style, label style, icon]. ㆍ is drawn as a middle dot since the font may lack the jamo.
const HAN = [
  ['인', 'ㅣ', 'vow', 'k1'], ['천', '·', 'vow', 'kdot'], ['지', 'ㅡ', 'vow', 'k1'],
  ['ㄱㅋ', 'ㄱㅋ', '', 'k2'], ['ㄴㄹ', 'ㄴㄹ', '', 'k2'], ['ㄷㅌ', 'ㄷㅌ', '', 'k2'],
  ['ㅂㅍ', 'ㅂㅍ', '', 'k2'], ['ㅅㅎ', 'ㅅㅎ', '', 'k2'], ['ㅈㅊ', 'ㅈㅊ', '', 'k2'],
  ['bs', '', 'fn', '', DEL], ['ㅇㅁ', 'ㅇㅁ', '', 'k2'], ['go', '', 'fn', '', GLOBE]
]
// English is multi-tap: press a key again to step through its letters.
const EN_LETTERS = { e1: '.,?!', e2: 'abc', e3: 'def', e4: 'ghi', e5: 'jkl', e6: 'mno', e7: 'pqrs', e8: 'tuv', e9: 'wxyz' }
const EN = [
  ['e1', '.,?!', '', 'ke'], ['e2', 'abc', '', 'ke'], ['e3', 'def', '', 'ke'],
  ['e4', 'ghi', '', 'ke'], ['e5', 'jkl', '', 'ke'], ['e6', 'mno', '', 'ke'],
  ['e7', 'pqrs', '', 'ke'], ['e8', 'tuv', '', 'ke'], ['e9', 'wxyz', '', 'ke'],
  ['bs', '', 'fn', '', DEL], ['sp', '', '', '', SPACE], ['go', '', 'fn', '', GLOBE]
]
const NUM = [
  ['1', '1', '', 'kn'], ['2', '2', '', 'kn'], ['3', '3', '', 'kn'],
  ['4', '4', '', 'kn'], ['5', '5', '', 'kn'], ['6', '6', '', 'kn'],
  ['7', '7', '', 'kn'], ['8', '8', '', 'kn'], ['9', '9', '', 'kn'],
  ['bs', '', 'fn', '', DEL], ['0', '0', '', 'kn'], ['go', '', 'fn', '', GLOBE]
]
const SETS = [HAN, EN, NUM]
const asKeys = (set) => set.map((b) => ({ k: b[0], l: b[1], cls: b[2], tcls: b[3], ic: b[4] || '' }))

export default {
  protected: { title: '입력', init: '' },
  private: {
    text: '',
    arc: [],
    shown: '',
    mode: 0, // 0 한글, 1 English, 2 123
    editing: true, // false right after a space, delete or mode change: the next key starts a new character
    lastKey: '', // the English key last pressed, for multi-tap
    lastAt: 0,
    cyc: 0,
    strip: [],
    caretOn: true,
    keys: asKeys(HAN)
  },

  onInit() {
    this.text = this.init
    this.arc = arcText(this.title)
    this.editing = false
    this.update()
  },

  /* The cursor blinks only while this scene is on screen. */
  onShow() {
    if (!blink) blink = setInterval(() => { this.caretOn = !this.caretOn }, 530)
  },
  onHide() {
    this.stopBlink()
  },
  onDestroy() {
    this.stopBlink()
  },
  stopBlink() {
    if (blink) clearInterval(blink)
    blink = 0
  },

  tap(k) {
    this.caretOn = true
    // a short tick on every key, like a hardware keyboard
    try {
      vibrator.vibrate({ mode: 'short' })
    } catch (e) {
      // no vibrator on this device
    }
    if (k === 'bs') {
      this.text = backspace(this.text) // a whole character, not one key press
      this.editing = false
      this.lastKey = ''
    } else if (k === 'go') {
      this.mode = (this.mode + 1) % 3
      this.keys = asKeys(SETS[this.mode])
      this.editing = false
      this.lastKey = ''
    } else if (this.mode === 0) {
      this.text = press(this.text, k, this.editing)
      this.editing = true
    } else if (this.mode === 1) {
      if (k === 'sp') this.addSpace()
      else this.multitap(k)
    } else {
      this.text += k
    }
    this.update()
  },

  multitap(k) {
    const letters = EN_LETTERS[k]
    const now = Date.now()
    if (this.lastKey === k && now - this.lastAt < 900 && this.text) {
      this.cyc = (this.cyc + 1) % letters.length
      this.text = this.text.slice(0, -1) + letters[this.cyc]
    } else {
      this.cyc = 0
      this.text += letters[0]
    }
    this.lastKey = k
    this.lastAt = now
  },

  addSpace() {
    if (!this.text || this.text.slice(-1) === ' ') return
    this.text += ' '
    this.editing = false
    this.lastKey = ''
  },

  space() {
    this.addSpace()
    this.update()
  },

  /* A suggestion replaces the word being typed; a letter chip picks that letter directly. */
  choose(w) {
    if (this.mode === 0) {
      this.text = this.text.slice(0, this.text.lastIndexOf(' ') + 1) + w + ' '
      this.editing = false
    } else if (this.mode === 1 && this.lastKey) {
      this.text = this.text.slice(0, -1) + w
      this.cyc = EN_LETTERS[this.lastKey].indexOf(w)
    }
    this.update()
  },

  update() {
    const d = display(this.text)
    this.shown = d.length > 12 ? '…' + d.slice(-11) : d
    if (this.mode === 1) {
      const letters = this.lastKey ? EN_LETTERS[this.lastKey] : ''
      this.strip = letters.split('').map((c, i) => ({ w: c, hi: i === this.cyc }))
    } else if (this.mode === 0) {
      this.suggestWords()
    } else {
      this.strip = []
    }
  },

  async suggestWords() {
    const mine = ++seq
    const q = atoms(this.text.slice(this.text.lastIndexOf(' ') + 1))
    if (!q) {
      this.strip = []
      return
    }
    try {
      const words = (await suggest(q, MAX_SUGGEST)).slice(0, MAX_SUGGEST)
      if (mine !== seq) return
      this.strip = words.map((w, i) => ({ w, hi: i === 0 }))
    } catch (e) {
      if (mine === seq) this.strip = []
    }
  },

  ok() {
    finishIme(this.text.replace(/\s+$/, ''))
  }
}
</script>

<style>
@import "../../common/arc.css";
/* Stadium-shaped screen: the title sits below the rounded top, the confirm button is narrower than the rest. */
.page { flex-direction: column; align-items: center; width: 212px; height: 520px; background-color: #000; }
.arc { width: 212px; height: 46px; }
.rn50 { transform: rotate(-50deg); }

.txt { width: 212px; height: 72px; margin-top: 2px; padding: 0 4px; }
.tv { font-size: 32px; font-weight: bold; color: #fff; line-height: 36px; lines: 2; }
.ph { color: #5a5a60; }
.caret { color: #3a7bff; }
.off { color: rgba(58, 123, 255, 0); }

.strip { width: 212px; height: 42px; margin-top: 4px; border-radius: 21px; background-color: #1c1c1e; }
.srow { flex-direction: row; align-items: center; height: 42px; padding: 0 14px; }
.sc { margin-right: 12px; }
.sw { font-size: 22px; color: #fff; }
.hi { color: #4d8dff; }

.pad { flex-direction: row; flex-wrap: wrap; width: 212px; margin-top: 4px; }
.key { width: 68px; height: 63px; margin: 1px; border-radius: 18px; background-color: #1b2230; align-items: center; justify-content: center; }
.vow { background-color: #1b2230; }
.fn { background-color: #2a3441; }
.ki { width: 40px; height: 40px; }
.k1 { font-size: 36px; color: #fff; }
.kdot { font-size: 48px; color: #fff; }
.k2 { font-size: 26px; color: #fff; }
.kn { font-size: 34px; color: #fff; }
.ke { font-size: 24px; color: #fff; }

.ok { width: 164px; height: 56px; margin-top: 4px; border-radius: 28px; background-color: #3a7bff; align-items: center; justify-content: center; }
.oi { width: 40px; height: 40px; }
</style>
